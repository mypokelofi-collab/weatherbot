# Copy to .env and edit. Every setting maps to config/flowbot.yml as
# FLOWBOT_<SECTION>__<FIELD>, and environment variables win over the file.

# ---- dashboard -------------------------------------------------------------
# Required if you publish the port to the internet. Then open
#   http://your-vps:8033/?token=<the same value>
FLOWBOT_SERVER__AUTH_TOKEN=change-me-to-a-long-random-string

# Where docker publishes the dashboard. Use 127.0.0.1 to keep it behind an
# SSH tunnel instead of exposing it.
BIND_ADDR=0.0.0.0
# Pick a port nothing else on the host is using.
HOST_PORT=8033
# Only needed if the host already has a container by this name.
#CONTAINER_NAME=flowbot-btc15m

# ---- market ----------------------------------------------------------------
# binance-futures | binance-spot | coinbase | simulator
FLOWBOT_DATA__VENUE=binance-futures
FLOWBOT_DATA__SYMBOL=BTCUSDT
FLOWBOT_DATA__INTERVAL=15m
# binance-spot has a $5 minimum notional, so a small bankroll sizes properly
# there - at the cost of being long-only.

# Capture the live feed for later backtests (a few hundred MB per day).
FLOWBOT_DATA__RECORD=false

# ---- paper bankroll and risk ----------------------------------------------
# These OVERRIDE config/flowbot.yml. Leave them commented out to use the
# values in the config file (a $50 bankroll with the small-account settings
# the venue minimum requires - see the notes in config/flowbot.yml).
#
# On Binance USDⓈ-M BTCUSDT the smallest order the venue accepts is ~0.002 BTC
# (~$140 at $70k, because the minimum notional is $100). On a $50 bankroll
# that is ~2.8x leverage and risks 1-3% per trade depending on volatility.
# Raise START_EQUITY to ~1000+ for textbook 0.5% risk sizing.
#FLOWBOT_RISK__START_EQUITY=50
#FLOWBOT_RISK__RISK_PER_TRADE_PCT=0.5
#FLOWBOT_RISK__MAX_RISK_PER_TRADE_PCT=4.0
#FLOWBOT_RISK__DAILY_LOSS_LIMIT_PCT=10.0
#FLOWBOT_RISK__MAX_TRADES_PER_DAY=12
#FLOWBOT_RISK__ALLOW_SHORT=true

# ---- signal ----------------------------------------------------------------
#FLOWBOT_SIGNAL__ENTRY_THRESHOLD=0.35
#FLOWBOT_SIGNAL__EXIT_THRESHOLD=0.10
#FLOWBOT_SIGNAL__MIN_ADX=18

# ---- execution -------------------------------------------------------------
#FLOWBOT_EXECUTION__TAKER_FEE_BPS=4.5
#FLOWBOT_EXECUTION__MAKER_FEE_BPS=1.8
#FLOWBOT_EXECUTION__LATENCY_MS=120

# ---- prediction markets (read-only, paper) ---------------------------------
# Defaults in config/flowbot.yml already point this at the recurring 15m BTC
# window family with force_min_trades on. Override here only to change them.
FLOWBOT_POLYMARKET__ENABLED=true
#FLOWBOT_POLYMARKET__MARKET_SLUG_CONTAINS=btc-updown-15m
#FLOWBOT_POLYMARKET__WINDOW_SECONDS=900
#FLOWBOT_POLYMARKET__FORCE_MIN_TRADES=true
#FLOWBOT_POLYMARKET__FORCE_TRADE_BEFORE_CLOSE_S=120

FLOWBOT_LOG_LEVEL=INFO
